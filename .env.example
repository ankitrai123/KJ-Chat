# KJ Chat configuration. Copy to .env.local for development; set the same names in Vercel.
# Never commit real values. Variables prefixed NEXT_PUBLIC_ are embedded in browser code at
# build time and must never hold secrets.

# --- Public ---------------------------------------------------------------------------------
# Supabase project URL (Project Settings -> API). Local CLI: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). The legacy "anon" JWT also works; the old variable
# name NEXT_PUBLIC_SUPABASE_ANON_KEY is accepted as a fallback.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public URL of this app, used in auth email links and as the allowed request origin.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: per-file attachment limit in MB (default 25, max 50 = storage bucket limit).
NEXT_PUBLIC_MAX_ATTACHMENT_MB=25
# Optional: web push. Generate with `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Server only (never exposed to the browser) ----------------------------------------------
# Supabase secret key (sb_secret_...) or the legacy service_role key. Needed for sending
# messages (server-verified), calls, push delivery, account deletion and cleanup.
# The old variable name SUPABASE_SERVICE_ROLE_KEY is accepted as a fallback.
SUPABASE_SECRET_KEY=

# LiveKit Cloud (Project Settings -> Keys). URL looks like wss://<project>.livekit.cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Web push (private half of the VAPID pair) and a contact for push services.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Shared secret for /api/cron/maintenance (Vercel Cron sends it as a Bearer token).
# Generate with `openssl rand -hex 32`.
CRON_SECRET=

# --- Tests (optional) -------------------------------------------------------------------------
# Database integration tests: any PostgreSQL 15+ server the suite may create databases on.
# TEST_DATABASE_URL=postgres://postgres@127.0.0.1:54329/postgres
# Full-stack E2E + real-media tests against a dedicated test project:
# E2E_BASE_URL=http://localhost:3000
# E2E_SUPABASE_URL=
# E2E_SUPABASE_PUBLISHABLE_KEY=
# E2E_SUPABASE_SECRET_KEY=
